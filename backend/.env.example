SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=real
DB_URL=jdbc:mysql://localhost:13306/supportops?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
DB_USERNAME=supportops
DB_PASSWORD=supportops_dev
MYSQL_PORT=13306
MYSQL_ROOT_PASSWORD=supportops_root_dev
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRATION_SECONDS=7200
CORS_ALLOWED_ORIGINS=http://localhost:4173
AUTH_MAX_ACCOUNTS_PER_IP_PER_HOUR=5
INTEGRATION_CONNECT_TIMEOUT=3s
INTEGRATION_READ_TIMEOUT=8s
# 各平台可独立上线；enabled=false 时使用本地演示数据。
ERP_INTEGRATION_ENABLED=false
ERP_BASE_URL=https://erp.example.com/openapi
ERP_API_TOKEN=replace-with-erp-token
LOGISTICS_INTEGRATION_ENABLED=false
LOGISTICS_BASE_URL=https://logistics.example.com/openapi
LOGISTICS_API_TOKEN=replace-with-logistics-token
MEMBERSHIP_INTEGRATION_ENABLED=false
MEMBERSHIP_BASE_URL=https://membership.example.com/openapi
MEMBERSHIP_API_TOKEN=replace-with-membership-token
MONITORING_INTEGRATION_ENABLED=false
MONITORING_BASE_URL=https://monitoring.example.com/openapi
MONITORING_API_TOKEN=replace-with-monitoring-token
TICKETING_INTEGRATION_ENABLED=false
TICKETING_BASE_URL=https://tickets.example.com/openapi
TICKETING_API_TOKEN=replace-with-ticket-token
AI_MODE=mock
AI_API_KEY=replace-with-your-key
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_MODEL=glm-5.2
AI_TEMPERATURE=0.1
AI_MAX_TOKENS=1200
AI_TIMEOUT=20s
AI_MINIMUM_INTENT_CONFIDENCE=0.55
AI_REUSE_WINDOW_MINUTES=5
AI_MAX_DIAGNOSES_PER_MINUTE=5
AI_MAX_CONCURRENT_DIAGNOSES=2
DIAGNOSIS_CORE_POOL_SIZE=4
DIAGNOSIS_QUEUE_CAPACITY=100
